[Unit]
Description=Blockbuster privileged helper (zapret2 engine supervisor)
Documentation=https://github.com/dodoflix/blkbstr
After=network.target

[Service]
Type=simple
# BLKBSTR_GID is written by install.sh; without it the socket stays root-only and the GUI cannot
# connect.
EnvironmentFile=/etc/blkbstr/daemon.env
ExecStart=/usr/local/libexec/blkbstrd --socket-group-gid ${BLKBSTR_GID}
Restart=on-failure
RestartSec=2

RuntimeDirectory=blkbstr
RuntimeDirectoryMode=0755
LogsDirectory=blkbstr
# Holds the config to bring back up on boot; must survive a reboot, unlike RuntimeDirectory.
StateDirectory=blkbstr
StateDirectoryMode=0700

# The daemon manipulates the firewall and packet queues; it needs those capabilities and nothing
# else. Drop the rest so a compromised helper is not a general-purpose root shell.
# CAP_CHOWN is for one call: chgrp'ing the socket to the blkbstr group at startup. Without it that
# fails with EPERM even as root, and a root-only socket is a service no GUI can reach. It stays out
# of the ambient set; the engine and nft have no use for it.
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not yes: a config can point hostlist= or ipset= at a file in the user's home,
# and `yes` makes /home unreadable, so the engine's own --dry-run rejects a file the user
# can see. Writing there is still refused.
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/log/blkbstr /run/blkbstr /var/lib/blkbstr
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately absent. zapret2's attacks are Lua, and LuaJIT
# mprotects its generated code executable, which the seccomp filter blocks — the engine
# dies with "runtime code generation failed, restricted kernel?" before it sees a packet.
# The filter is inherited by children, so it cannot be kept for the daemon alone.

[Install]
WantedBy=multi-user.target
