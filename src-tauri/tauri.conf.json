{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockbuster",
  "version": "0.3.0",
  "identifier": "dev.blkbstr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blockbuster",
        "decorations": false,
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Blockbuster",
    "category": "Utility",
    "shortDescription": "A multi-platform GUI for zapret2.",
    "longDescription": "Install, configure and run zapret2 from a graphical app, with named configs that move between Linux, Windows and the BSDs.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRTI2MUFDMzY3RThGMDgKUldRSWozNDJyR0hpSTI0UWRQRjJhTmZCNGdINnRyM2syYXFoSFNBVDk3ZWlIOHgrTFQzVFY4cnQK",
      "endpoints": [
        "https://github.com/dodoflix/blkbstr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
